# ---------------------------------------------------------------------------
# Ansora environment variables
# Copy this file to `.env.local` (local dev) or configure in your host and fill
# in real values. Every variable is optional unless marked REQUIRED.
# ---------------------------------------------------------------------------

# --- Deployment mode -------------------------------------------------------
# self-hosted: reads/writes markdown on local disk + commits with git
# serverless : reads/writes markdown via the GitHub REST API (Vercel/Netlify)
DEPLOYMENT_MODE=self-hosted

# --- Admin credentials (REQUIRED) -------------------------------------------
# Generate the hash with:  npm run hash-password
# Example: ADMIN_PASSWORD_HASH=$2a$10$N9qo8uLOickgx2ZMRZoMye...
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Long random string (min 32 chars). Generate with:  openssl rand -base64 48
JWT_SECRET=

# --- Site -------------------------------------------------------------------
# Public base URL of your blog, used for canonical URLs, sitemap, RSS, OG tags.
SITE_URL=http://localhost:3000

# --- Self-hosted mode only ---------------------------------------------------
# Directory that holds /posts and site.config.json. Defaults to ./content
CONTENT_DIR=
# Commit + push after every save. Defaults to false (commit only).
GIT_AUTO_PUSH=false
# Git identity used for content commits (only set if the repo has none).
GIT_USER_NAME=Ansora
GIT_USER_EMAIL=ansora@localhost

# --- Serverless mode only ----------------------------------------------------
# GitHub repo "owner/name" that stores content (REQUIRED for serverless).
GITHUB_REPO=
# Personal access token with repo write scope (REQUIRED for serverless).
GITHUB_TOKEN=
# Branch to read/write. Defaults to main.
GITHUB_BRANCH=main
# Path inside the repo where posts live. Defaults to content/posts
GITHUB_CONTENT_PATH=content/posts
# Path inside the repo for site.config.json. Defaults to content/site.config.json
GITHUB_SITE_CONFIG_PATH=content/site.config.json
# same-repo: content lives in the app repo; external-repo: content is a separate repo.
CONTENT_REPO_MODE=same-repo

# --- Optional ----------------------------------------------------------------
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
